# Copy to local.env (kept out of git) and fill in, for scripts/build-ios.sh.

# Your Apple developer team ID (Xcode → Settings → Accounts, or developer.apple.com)
TEAM=XXXXXXXXXX

# An app ID of your own; the project's com.hughhowey.neo.pocket belongs to another team
BUNDLE_ID=com.example.neo.pocket

# The device to install on: `xcrun devicectl list devices` shows each one's Identifier
DEVICE=00000000-0000-0000-0000-000000000000

# Optional: defaults to iCloud.<BUNDLE_ID>
# ICLOUD_CONTAINER=iCloud.com.example.neo.pocket
